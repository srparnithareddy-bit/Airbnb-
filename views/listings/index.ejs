<% layout("/layouts/boilerplate") %>
<div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-4">
  <div>
    <h1 class="h2 mb-1">Find your next stay</h1>
    <p class="text-secondary mb-0">Discover places shared by the Wanderlust community.</p>
  </div>
  <% if (currentUser) { %><a class="btn btn-danger" href="/listings/new">Create a listing</a><% } %>
</div>
<% if (listings.length === 0) { %>
  <div class="empty-state text-center p-5">
    <h2 class="h4">No stays yet</h2>
    <p class="text-secondary">Be the first to share a place with the community.</p>
    <a href="/listings/new" class="btn btn-danger">Add the first listing</a>
  </div>
<% } else { %>
  <div class="row g-4">
    <% listings.forEach((listing) => { %>
      <div class="col-sm-6 col-lg-4 col-xl-3">
        <a class="listing-card text-decoration-none text-dark" href="/listings/<%= listing._id %>">
          <img src="<%= listing.image.url %>" alt="<%= listing.title %>" class="listing-image">
          <div class="pt-2">
            <h2 class="h6 mb-1"><%= listing.title %></h2>
            <p class="text-secondary small mb-1"><%= listing.location %>, <%= listing.country %></p>
            <p class="mb-0"><strong>$<%= listing.price.toLocaleString() %></strong> night</p>
          </div>
        </a>
      </div>
    <% }) %>
  </div>
<% } %>
