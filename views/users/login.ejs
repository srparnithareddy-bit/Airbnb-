<% layout("/layouts/boilerplate") %>
<div class="form-card mx-auto">
  <h1 class="h2 mb-4">Welcome back</h1>
  <% if (demoMode) { %>
    <div class="alert alert-info">
      <strong>Demo sign-ins</strong><br>
      Guest: <code>demo</code> / <code>wanderlust123</code><br>
      Host: <code>demo-host</code> / <code>wanderlust123</code>
    </div>
  <% } %>
  <form action="/login" method="POST">
    <div class="mb-3">
      <label class="form-label" for="username">Username</label>
      <input class="form-control" id="username" name="username" required autocomplete="username">
    </div>
    <div class="mb-4">
      <label class="form-label" for="password">Password</label>
      <input class="form-control" id="password" name="password" type="password" required autocomplete="current-password">
    </div>
    <button class="btn btn-danger w-100" type="submit">Log in</button>
  </form>
  <p class="mt-3 mb-0 text-center">New to Wanderlust? <a href="/register">Create an account</a></p>
</div>
